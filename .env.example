# Server configuration
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret

# Cloud MySQL Database (PlanetScale, Aiven, Railway, Google Cloud SQL, AWS RDS)
# Leave DATABASE_URL / DB_HOST unset to use the local SQLite fallback (data/civicpulse.db).
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/civicpulse

# Optional: set DB_SSL=true for cloud MySQL providers requiring TLS
DB_SSL=true
# Set to false only if your cloud provider uses a self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternative to DATABASE_URL (if you prefer separate fields):
# DB_HOST=your-mysql-host.example.com
# DB_PORT=3306
# DB_USER=civicpulse_user
# DB_PASSWORD=your_password
# DB_NAME=civicpulse
